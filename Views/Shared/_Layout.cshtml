<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - fictional_journey</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://res.cdn.office.net/files/fabric-cdn-prod_20240115.001/assets/icons/fabric-icons-0-13.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/fictional_journey.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header sticky-top">
        <nav class="navbar navbar-expand-sm">
            <div class="container-fluid app-shell">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="ms-Icon ms-Icon--Robot me-2" aria-hidden="true"></i>
                    fictional_journey
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 app-nav-links">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="ms-Icon ms-Icon--HomeSmall me-1" aria-hidden="true"></i>
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="ms-Icon ms-Icon--People me-1" aria-hidden="true"></i>
                                Employees
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-shell">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container app-shell d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
                <i class="ms-Icon ms-Icon--WebAppBuilderModule" aria-hidden="true"></i>
                &copy; 2026 - fictional_journey
            </span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Employee Directory</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
