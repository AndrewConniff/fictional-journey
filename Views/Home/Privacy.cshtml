@model IReadOnlyList<fictional_journey.Models.EmployeeRecord>

@{
    ViewData["Title"] = "Employee Directory";
}

<section class="fluent-panel mt-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h1 class="fluent-title m-0">
            <i class="ms-Icon ms-Icon--People me-2" aria-hidden="true"></i>
            Employee Directory
        </h1>
        <span class="fluent-chip">
            <i class="ms-Icon ms-Icon--Group me-1" aria-hidden="true"></i>
            @Model.Count Employees
        </span>
    </div>

    <p class="fluent-subtitle">
        Data is loaded server-side from <strong>wwwroot/data/sampledata.json</strong>.
    </p>

    <div class="table-responsive">
        <table class="fluent-table" aria-label="Employee table">
            <thead>
                <tr>
                    <th><i class="ms-Icon ms-Icon--Contact me-1" aria-hidden="true"></i> First Name</th>
                    <th>Last Name</th>
                    <th><i class="ms-Icon ms-Icon--Calendar me-1" aria-hidden="true"></i> Hiring Date</th>
                    <th><i class="ms-Icon ms-Icon--Org me-1" aria-hidden="true"></i> Department</th>
                    <th><i class="ms-Icon ms-Icon--Work me-1" aria-hidden="true"></i> Job Title</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5">No employee records found.</td>
                    </tr>
                }
                else
                {
                    foreach (var employee in Model)
                    {
                        <tr>
                            <td>@employee.FirstName</td>
                            <td>@employee.LastName</td>
                            <td>@employee.HiringDate</td>
                            <td>@employee.Department</td>
                            <td>@employee.JobTitle</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
